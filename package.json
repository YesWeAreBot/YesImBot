{
  "name": "@root/yesimbot",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/HydroGest/YesImBot",
  "license": "MIT",
  "contributors": [
    "HydroGest <2445691453@qq.com>",
    "Dispure <3116716016@qq.com>",
    "Miaowfish <1293865264@qq.com>",
    "Touch-Night <1762918301@qq.com>"
  ],
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yakumo build",
    "clean": "yakumo clean",
    "collect-packages": "node scripts/collect-packages.js",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "pack:all": "yarn workspaces foreach -A --no-private exec npm pack",
    "prepare": "husky",
    "test": "vitest run",
    "verify-packages": "node scripts/verify-packages.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@koishijs/client": "^5.30.11",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yakumo": "^3.2.1",
    "yakumo-client": "workspace:*",
    "yakumo-esbuild": "^3.0.2",
    "yakumo-tsc": "^3.0.1",
    "yakumo-vitest": "^1.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
