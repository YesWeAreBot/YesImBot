{
  "name": "@yesimbot/koishi-plugin-provider-openai",
  "version": "0.0.1",
  "description": "YesImBot OpenAI model provider plugin",
  "bugs": {
    "url": "https://github.com/YesWeAreBot/YesImBot/issues"
  },
  "license": "MIT",
  "contributors": [
    "MiaowFISH <miaowfish@qq.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YesWeAreBot/YesImBot.git",
    "directory": "providers/openai"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "module": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.65"
  },
  "devDependencies": {
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^"
  },
  "peerDependencies": {
    "koishi": "^4.18.10",
    "koishi-plugin-yesimbot": "workspace:^"
  },
  "koishi": {
    "description": {
      "zh": "OpenAI 模型提供商插件（支持 chat / responses 格式与原生 Web 搜索）",
      "en": "OpenAI model provider plugin (chat / responses formats with native web search)"
    },
    "service": {
      "required": [
        "yesimbot"
      ]
    }
  }
}
